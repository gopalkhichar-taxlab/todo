# Per-app API config. Copy to apps/api/.env for local dev.

NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=debug

# Postgres
DATABASE_URL=postgres://kudo:kudo@localhost:5432/kudo

# JWT (generate with `openssl rand -base64 64` for production)
JWT_ACCESS_SECRET=replace-with-a-real-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-another-real-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000
