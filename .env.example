# Root-level shared env. Per-app secrets live in apps/*/.env

# Postgres (used by docker-compose and the API)
POSTGRES_USER=kudo
POSTGRES_PASSWORD=kudo
POSTGRES_DB=kudo
POSTGRES_PORT=5432

# Base URL for the API (no trailing slash; /v1 prefix is included in each request path)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
